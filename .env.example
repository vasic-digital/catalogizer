# Catalogizer Environment Configuration
# Copy this file to .env and update with your values

# Application Environment
APP_ENV=development  # development, staging, production
LOG_LEVEL=debug      # debug, info, warn, error

# Release / version naming (Constitution §11.4.151)
# Every release tag and version name on the main repo AND every owned
# submodule MUST be prefixed with this value, form: <PREFIX>-<version>.
# Resolution order: (1) HELIX_RELEASE_PREFIX from .env (authoritative);
# (2) fallback = lowercased snake_case of the project root dir name.
# For this project the prefix is the project name: catalogizer.
HELIX_RELEASE_PREFIX=catalogizer

# API Configuration
API_PORT=8080

# Database Configuration (PostgreSQL)
# NOTE: docker-compose.yml and docker-compose.dev.yml interpolate POSTGRES_PASSWORD (postgres service)
# and DATABASE_PASSWORD (api service) from your gitignored .env — both are REQUIRED
# (compose fails loudly if unset) and MUST match. Never commit the real value.
DATABASE_TYPE=postgres
POSTGRES_USER=catalogizer
POSTGRES_PASSWORD=your_dev_db_password
DATABASE_PASSWORD=your_dev_db_password
POSTGRES_DB=catalogizer_dev
POSTGRES_PORT=5432

# For development with SQLite (alternative to PostgreSQL)
# DATABASE_TYPE=sqlite
# SQLITE_PATH=./catalogizer.db

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_RATE_LIMIT=false

# Security
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# --- Required compose secrets (no defaults) ---
# docker-compose.yml and deployment/docker-compose.yml interpolate these with the
# `${VAR:?...}` form: `compose up` / `compose config` FAILS LOUDLY if one is unset
# (there is deliberately no built-in default). Set real values in your gitignored
# .env; the CHANGE_ME placeholders below are NOT valid credentials.
GRAFANA_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Also required (documented above): DATABASE_PASSWORD, JWT_SECRET (and POSTGRES_PASSWORD for docker-compose.yml / the dev compose).
# ADMIN_PASSWORD (and JWT_SECRET) are required by docker-compose.test.yml / docker-compose.qa.yml and the QA scripts;
# scripts/lib/install_env.sh install_write_env generates strong values. Never reuse a placeholder.
ADMIN_PASSWORD=CHANGE_ME
# QA_USER_PASSWORD: password of the throwaway `testuser_qa` account registered by scripts/run-full-qa.sh;
# required there (`${QA_USER_PASSWORD:?}`) and must differ from ADMIN_PASSWORD.
QA_USER_PASSWORD=CHANGE_ME
# Optional: SNYK_TOKEN (docker-compose.security.yml). When empty, scripts/security-test.sh skips Snyk.
# Test-infrastructure variables (TI_*, FTPS_*, SFTP_*) are GENERATED by scripts/test-infra/*.sh; do not set by hand.

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# SMB/File System Configuration
SMB_ENABLED=true
MEDIA_ROOT_PATH=./media

# ─── Network-share identities (identity-driven share discovery) ────────────
# The System scans the network + every supported interface/protocol for hosts
# and shares. Each discovered share is tried first with NO identity (anonymous),
# then with each identity below in order until one authenticates. Working
# (share, identity) pairs are remembered and reused.
# type ∈ { credentials | api_token | ssh_key | ... (extensible) }
# Real values live ONLY in the gitignored .env — never here (§11.4.10).
CATALOGIZER_IDENTITY_COUNT=2
CATALOGIZER_IDENTITY_1_TYPE=credentials
CATALOGIZER_IDENTITY_1_USERNAME=<username>
CATALOGIZER_IDENTITY_1_PASSWORD=<password>
CATALOGIZER_IDENTITY_2_TYPE=credentials
CATALOGIZER_IDENTITY_2_USERNAME=<username>
CATALOGIZER_IDENTITY_2_PASSWORD=<password>
# Other supported types (uncomment + renumber as needed):
# CATALOGIZER_IDENTITY_3_TYPE=api_token
# CATALOGIZER_IDENTITY_3_TOKEN=<token>
# CATALOGIZER_IDENTITY_4_TYPE=ssh_key
# CATALOGIZER_IDENTITY_4_KEY_PATH=<path-to-private-key>
# CATALOGIZER_IDENTITY_4_PASSPHRASE=<optional>

# Container Configuration (for production)
GO_VERSION=1.24
HTTP_PORT=80
HTTPS_PORT=443

# ─── Security Scanning ─────────────────────────────────────
SNYK_TOKEN=YOUR_SNYK_TOKEN_HERE

# ─── Metadata Providers (optional) ─────────────────────────
TMDB_API_KEY=YOUR_TMDB_KEY_HERE
OMDB_API_KEY=YOUR_OMDB_KEY_HERE

# ─── HelixQA / AI Configuration (not used by catalog-api) ──
# These variables are consumed by HelixQA and related AI/vision
# tooling, not by the catalog-api Go backend.
# See HelixQA/.env.example for full configuration.
HELIX_VISION_HOSTS=thinker.local,amber.local
HELIX_VISION_MULTI_USER=milosvasic
HELIX_LLAMACPP_RPC_MODEL=~/models/vision-model.gguf
HELIX_OLLAMA_URL=http://thinker.local:11434
HELIX_OLLAMA_MODEL=minicpm-v:8b
ASTICA_API_KEY=YOUR_ASTICA_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
NVIDIA_API_KEY=YOUR_NVIDIA_KEY_HERE

# HelixQA Configuration
# When set to true, removes all past QA session data when starting a new run
# Only the current session will be kept after completion
HELIX_QA_CLEAN_ALL_ON_NEW_RUN=false

# Distributed Build Configuration
# When enabled, builds are distributed across multiple hosts based on resource availability.
# Hosts must have passwordless SSH access and a container runtime (Podman/Docker).

BUILD_DISTRIBUTED=false
BUILD_HOST_1_NAME=thinker
BUILD_HOST_1_ADDRESS=thinker.local
BUILD_HOST_1_USER=milosvasic
BUILD_HOST_1_KEY_PATH=~/.ssh/id_ed25519
BUILD_HOST_1_RUNTIME=podman
BUILD_HOST_1_LABELS=go=true,npm=true,jdk=true,rust=true

BUILD_HOST_2_NAME=amber
BUILD_HOST_2_ADDRESS=amber.local
BUILD_HOST_2_USER=milosvasic
BUILD_HOST_2_KEY_PATH=~/.ssh/id_ed25519
BUILD_HOST_2_RUNTIME=podman
BUILD_HOST_2_LABELS=go=true,npm=true,jdk=true

BUILD_SCHEDULER_STRATEGY=resource_aware
BUILD_REMOTE_DIR=/tmp/catalogizer-build
BUILD_TIMEOUT_MINUTES=30

# ─── Firebase App Distribution ──────────────────────────────────────────
# Comma-separated list of tester emails for Firebase App Distribution.
# These testers will receive builds distributed via scripts/distribute.sh.
# Use non-production emails for testing.
FIREBASE_TESTER_EMAILS=tester1@example.com,tester2@example.com

# Firebase App IDs for each distributed artifact.
# Find these in the Firebase Console → Project Settings → General → Your apps.
FIREBASE_API_APP_ID=1:123456789012:android:abc123def456
FIREBASE_ANDROIDTV_APP_ID=1:123456789012:android:789ghi012jkl

# ─── google-services.json regeneration (scripts/generate_google_services.sh) ─
# The 5 vars below are REQUIRED by scripts/generate_google_services.sh to
# produce app/google-services.json at build time. The script reads them from
# .env, substitutes them into app/google-services.json.example, and writes
# the real google-services.json (git-ignored per §11.4.30).
#
# Obtain the real values from:
#   Firebase Console → Project Settings → General → Your apps → <your app>
FIREBASE_PROJECT_NUMBER=123456789012
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MOBILE_SDK_APP_ID=1:123456789012:android:abc123
FIREBASE_API_KEY=AIzaSy...

# --- Android App Signing (placeholders — replace with real values) ---
# RELEASE_STORE_FILE=./docker/signing/catalogizer-release.keystore
# RELEASE_STORE_PASSWORD=RELEASE_STOREPASS
# RELEASE_KEY_ALIAS=catalogizer-release
# RELEASE_KEY_PASSWORD=RELEASE_KEYPASS
# DEV_STORE_FILE=./docker/signing-dev/catalogizer-dev.keystore
# DEV_STORE_PASSWORD=dev-storepass
# DEV_KEY_ALIAS=catalogizer-dev
# DEV_KEY_PASSWORD=dev-keypass

# --- Firebase Distribution (sample — replace with real) ---
# FIREBASE_ANDROIDTV_APP_ID=1:881377664729:android:751a0d0e2d873db47768c8
# FIREBASE_API_APP_ID=1:881377664729:web:25328343c36464d37768c8
# FIREBASE_TESTER_EMAILS=tester1@example.com,tester2@example.com
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# --- Optional compose profiles (required only when that compose file is used) ---
# docker-compose.dev.yml
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
# docker-compose.security.yml (one variable feeds both SonarQube and its database)
SONAR_DB_PASSWORD=CHANGE_ME
# deploy/infra-compose.yml uses POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD (above)

# --- Live NAS tests (catalog-api/filesystem/live_nas_test.go, go test -tags live); values stay in the private .env ---
# SYNOLOGY_SMB_USER=
# SYNOLOGY_SMB_PASSWORD=
# SYNOLOGY_IP_1= ... SYNOLOGY_IP_7=
# LIVE_SMB_SHARES=            # optional "SHARE:folder,SHARE:folder" override
# LIVE_SMB_OPTIONAL_SHARES=   # optional, shares exercised only when mountable
# LIVE_FTP_SHARES=            # optional "SHARE:folder,..."
# LIVE_SPECIAL_REQUIRED=      # optional, shares that must yield ASCII special-character names
