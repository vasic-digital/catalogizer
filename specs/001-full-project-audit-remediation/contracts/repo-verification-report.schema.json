{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-verification-report/1",
  "title": "Recursive repository verification report (FR-019, FR-020, SC-010)",
  "description": "Shape of the JSON written by poc/repo_verify/verify_repo.sh --json-out. Derived from the jq assembly in verify_repo.sh (lines 238-269) and validated against poc/repo_verify/results/run1.json and a fresh run on 2026-10-03. Producer: verify_repo.sh (promoted to scripts/repo/verify_repos.sh by WP-03, which keeps this v1 shape and the constant tool name and accepts both --json and --json-out). Consumers: commit-and-push script stage S7 (verify; S8 reports), SC-010 acceptance check, register Repository Verification Record import.",
  "type": "object",
  "required": ["tool", "root", "generated_utc", "fetch", "strict", "summary", "repos"],
  "additionalProperties": false,
  "properties": {
    "tool": {"const": "verify_repo.sh"},
    "root": {"type": "string", "minLength": 1, "description": "absolute path of the main repository"},
    "generated_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "fetch": {"type": "boolean", "description": "true when --fetch was given (objects fetched into .git, never merged)"},
    "strict": {"type": "boolean", "description": "true when --strict was given (behind, pin drift and unproven also fail)"},
    "summary": {
      "type": "object",
      "required": ["repos", "owned", "dirty", "dirty_excepted", "ahead", "diverged", "pin_drift", "unproven", "classes", "failing"],
      "additionalProperties": false,
      "properties": {
        "repos": {"type": "integer", "minimum": 1},
        "owned": {"type": "integer", "minimum": 0},
        "dirty": {"type": "integer", "minimum": 0, "description": "repositories with any tracked or untracked change, excepted ones included"},
        "dirty_excepted": {"type": "integer", "minimum": 0},
        "ahead": {"type": "integer", "minimum": 0, "description": "repositories with at least one REMOTE-BEHIND remote (unpushed commits)"},
        "diverged": {"type": "integer", "minimum": 0},
        "pin_drift": {"type": "integer", "minimum": 0},
        "unproven": {"type": "integer", "minimum": 0},
        "classes": {
          "type": "object",
          "description": "count of remote comparisons per class",
          "propertyNames": {"$ref": "#/$defs/remoteClass"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "failing": {"type": "integer", "minimum": 0, "description": "repositories whose problems list is non-empty"}
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repo"}
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remoteClass": {"enum": ["SAME", "REMOTE-BEHIND", "LOCAL-BEHIND", "DIVERGED", "UNREACHABLE", "NO-REMOTE-BRANCH", "UNKNOWN-DIFFERENT"]},
    "remote": {
      "type": "object",
      "required": ["remote", "url", "remote_tip", "class"],
      "additionalProperties": false,
      "properties": {
        "remote": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "remote_tip": {"type": "string", "pattern": "^([0-9a-f]{40})?$", "description": "empty when UNREACHABLE or NO-REMOTE-BRANCH"},
        "class": {"$ref": "#/$defs/remoteClass"}
      },
      "allOf": [
        {"if": {"properties": {"class": {"enum": ["UNREACHABLE", "NO-REMOTE-BRANCH"]}}}, "then": {"properties": {"remote_tip": {"const": ""}}}},
        {"if": {"properties": {"class": {"enum": ["SAME", "REMOTE-BEHIND", "LOCAL-BEHIND", "DIVERGED", "UNKNOWN-DIFFERENT"]}}}, "then": {"properties": {"remote_tip": {"$ref": "#/$defs/sha40"}}}}
      ]
    },
    "repo": {
      "type": "object",
      "required": ["path", "pin", "head", "branch", "owned", "dirty", "dirty_tracked", "dirty_untracked", "remotes", "pin_state", "excepted", "exception_reason", "problems", "unproven"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "'.' for the main repository, else the submodule display path"},
        "pin": {"enum": [".", " ", "+", "-", "U", "="], "description": "first character of git submodule status ('.' = main repository)"},
        "head": {"type": "string", "pattern": "^([0-9a-f]{40})?$", "description": "empty when the checkout is missing"},
        "branch": {"type": "string", "description": "empty when HEAD is detached"},
        "owned": {"type": "boolean"},
        "dirty": {"type": "boolean"},
        "dirty_tracked": {"type": "integer", "minimum": 0},
        "dirty_untracked": {"type": "integer", "minimum": 0},
        "remotes": {"type": "array", "items": {"$ref": "#/$defs/remote"}, "description": "compared only for owned repositories on a branch; empty otherwise"},
        "pin_state": {"enum": ["ok", "drifted", "uninitialised", "conflict", "?"]},
        "excepted": {"type": "boolean"},
        "exception_reason": {"type": ["string", "null"]},
        "problems": {"type": "array", "uniqueItems": true, "items": {"enum": ["dirty", "ahead", "diverged", "behind", "pin"]}},
        "unproven": {"type": "array", "uniqueItems": true, "items": {"enum": ["UNREACHABLE", "UNKNOWN-DIFFERENT", "NO-REMOTE-BRANCH"]}}
      },
      "allOf": [
        {"if": {"properties": {"excepted": {"const": true}}}, "then": {"properties": {"exception_reason": {"type": "string", "minLength": 1}, "dirty": {"const": true}}}},
        {"if": {"properties": {"owned": {"const": false}}}, "then": {"properties": {"remotes": {"maxItems": 0}}}}
      ]
    }
  }
}
