# IMG-SIGVERIFY (T106, T149): cosign for publisher-signature verification of scanner images. Interpreter class: it reads signatures and
# registry metadata and compiles nothing. FROM docker.io/library/debian:bookworm-slim, the image index digest of IMG-TESTUTIL-BASE in
# build/containers/images.lock.yaml; apt is pinned to the dated Debian snapshot of the base image's own source date (2026-09-18).
FROM docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20260918T000000Z\nSuites: bookworm\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' > /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\n' > /etc/apt/apt.conf.d/99snapshot
# cosign v3.1.3 (release of 2026-08-06): the binary is verified against SHA-256 4629c757... below, which equals the value published in the
# release's cosign_checksums.txt (both read 2026-10-06); curl is installed only for this one download and removed in the same RUN.
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /usr/local/bin/cosign https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64 \
 && echo "4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71  /usr/local/bin/cosign" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/cosign \
 && apt-get purge -y -qq curl && apt-get autoremove -y -qq && rm -rf /var/lib/apt/lists/*
LABEL project=catalogizer image=IMG-SIGVERIFY
