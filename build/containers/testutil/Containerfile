# IMG-TESTUTIL (T006): test and check tools for the P0 tests and the CPA S2/S3 checks. Built rootless; every FROM is digest-pinned.
# FROM docker.io/library/debian:bookworm-slim, the image index digest recorded in build/containers/images.lock.yaml (IMG-TESTUTIL-BASE).
FROM docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
# Apt is pinned to a dated snapshot (the timestamp is the base image's own source date, 2026-09-18); Valid-Until is not enforced for a snapshot.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20260918T000000Z\nSuites: bookworm\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' > /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\n' > /etc/apt/apt.conf.d/99snapshot \
 && apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      bash git sqlite3 python3 python3-jsonschema python3-yaml python3-pytest python3-venv jq bsdutils coreutils ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# CPA check tools in a virtual environment, hash-pinned (pip --require-hashes); detect-private-key comes with pre-commit-hooks.
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/cpa-tools \
 && /opt/cpa-tools/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt
LABEL project=catalogizer
