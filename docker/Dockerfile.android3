# Catalogizer Android Builder Image with JDK 21
# Ubuntu 22.04 with JDK 21 + Android SDK
# Provides complete JDK toolchain with jmods for Android Gradle Plugin 8.1.0

FROM docker.io/library/ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

LABEL maintainer="Catalogizer Team"
LABEL description="Android builder for Catalogizer project with JDK 21 and complete toolchain"

# Use bash shell
SHELL ["/bin/bash", "-c"]

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

# Install OpenJDK 21 with full development tools (includes jlink, jmods)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk \
    openjdk-21-jdk-headless \
    curl \
    wget \
    unzip \
    zip \
    git \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Non-root: a dedicated build user (uid 1000) owns the Android SDK and its own HOME. Ubuntu 24.04 ships a uid-1000 "ubuntu" user, which is replaced.
RUN if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && useradd --create-home --uid 1000 --shell /bin/bash builder \
    && mkdir -p "${ANDROID_HOME}" && chown builder:builder "${ANDROID_HOME}"
USER builder

# Verify JDK installation has jmods
RUN java -version && \
    jlink --version && \
    echo "JDK toolchain verified" && \
    ls -la /usr/lib/jvm/java-21-openjdk-amd64/jmods/

# Set Gradle properties to disable JDK image transform
ENV GRADLE_OPTS="-Dandroid.useNewJdkImageTransform=false -Dandroid.experimental.jdkImageTransform=false -Dandroid.enableNewJdkImageTransform=false -Dandroid.experimental.useNewJdkImageTransform=false"
ENV ORG_GRADLE_JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV ANDROID_JDK_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# Download and install Android Command Line Tools with retry
RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && cd "${ANDROID_HOME}/cmdline-tools" \
    && for i in 1 2 3 4 5; do \
        echo "Attempt $i: Downloading Android cmdline-tools..." && \
        curl --retry 5 --retry-delay 10 --retry-all-errors -fL \
            "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -o cmdline-tools.zip && \
        break || (echo "Attempt $i failed, waiting 15s..." && sleep 15); \
    done \
    && unzip -q cmdline-tools.zip \
    && mv cmdline-tools latest \
    && rm cmdline-tools.zip

# Accept licenses and install required SDK components
# No `|| true`: the exit status of the pipeline is sdkmanager's, so a licence that cannot be accepted fails the build (owner decision 2026-10-07).
RUN yes | sdkmanager --licenses >/dev/null

# Install Android SDK components with retry
RUN for i in 1 2 3; do \
    echo "Attempt $i to install Android SDK components..." && \
    sdkmanager \
        "platform-tools" \
        "build-tools;34.0.0" \
        "platforms;android-33" \
        "sources;android-33" \
        "platforms;android-34" \
        "sources;android-34" \
        "extras;android;m2repository" \
        "extras;google;m2repository" \
        && break || (echo "Attempt $i failed, waiting 10s..." && sleep 10); \
    done

# Clean up
USER root
RUN apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && mkdir -p /project && chown builder:builder /project
USER builder

# Verify Android SDK installation
RUN sdkmanager --list_installed 2>/dev/null | head -20 && echo "Android SDK installation verified"

# Set working directory
WORKDIR /project

# Health check: the toolchain this image exists to provide must be runnable by the build user
HEALTHCHECK --interval=60s --timeout=20s --start-period=10s --retries=3 \
  CMD java -version && sdkmanager --version || exit 1

# Default command
CMD ["bash"]
