#!/bin/bash -p
# cpa-host - the host entry point of the commit-push script (docs/16 section 12.2.8; tasks.md T042, CENTRAL C3, C5; constitution 11.4.234).
#
# Purpose   A CPA run starts only here. This small fixed script is installed by the OWNER outside every repository ($CPA_HOST_ENTRY, default
#           $HOME/.local/bin/cpa-host, procedure scripts/repo/host_entry/INSTALL.md) and holds NO review logic: it resolves the main repository,
#           reads the owner's trust file once, copies the approved manifest from the content-addressed store into the run's own directory and
#           executes the copied scripts/commit-push-all.sh from there. So what a run executes is decided only by the owner's approvals, never by
#           the working tree, a held change or a foreign commit.
# Usage     cpa-host [--run-id <id>] <commit-push-all.sh arguments...>      run mode
#           cpa-host --show                                                  read-only: its own sha256 and the project's trust entry
#           cpa-host --owner-trust <op> ...      NOT BUILT (20 owner_op_unimplemented): approve, retire, revoke and reanchor are the owner
#                                                  checkpoint T046a; a test harness writes its own throwaway trust state directly
#           cpa-host --resume | --check-provenance | --exec-approved ...     NOT BUILT (20 mode_unimplemented): T121b, T094d, CENTRAL C5/C8
# State     $CPA_HOST_STATE (default $HOME/.local/state/cpa-host/, mode 0700, outside every repository): trust.json (cpa-host-trust/1) and the
#           store blobs/<sha256> of approved file copies (mode 0400). This script reads them and never writes them.
# Run mode  (i) the project root: from the working directory, the innermost repository of the chain (git rev-parse --show-toplevel upwards by
#           --show-superproject-working-tree) whose work tree holds scripts/repo/host_entry/cpa-host; none gives 20 project_not_trusted
#           (no_project_root). (ii) the trust entry, keyed by the root commit of HEAD's first-parent chain; an absent or unparsable trust file, no
#           entry, a manifest without scripts/commit-push-all.sh, or an adoption_commit that is not on HEAD's first-parent chain gives 20
#           project_not_trusted. (iii) the run id: the UTC time, the process id and a random suffix, or --run-id <id> (^[A-Za-z0-9_-]+$ and no
#           such run directory yet, else 20 run_id_invalid with reason run_id_malformed or run_id_in_use); --run-id with --resume is a usage_error.
#           The grammar is ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$: the common subset of the three that read a run id (this script, longops/acquire.sh, lib_safe.sh
#           safe_runid), so an id that passes here is never refused by a later stage. A relative `--paths-from FILE` is read from the directory cpa-host was
#           STARTED in (resolved here, before the change into the root); `--repo PATH` and `--resolve-merge DIR` are relative to the repository root.
#           (iv) mkdir -p .audit/commit-push, then mkdir of the run directory WITHOUT -p (of two runs given one id only one proceeds), the empty
#           no-hooks/ directory, every manifest path copied from the store into released/ and re-hashed (a mismatch gives 20 approved_copy_invalid
#           and the run directory is removed again), released/trust-snapshot.json (cpa-host-snapshot/1: entries and manifest_sha256, the sha256 of
#           the canonical bytes of the entries sorted by path). (v) exec released/scripts/commit-push-all.sh with the same arguments, CPA_ROOT,
#           CPA_RUN_ID and CPA_ADOPTION_COMMIT in the environment.
# Refusals  printed as one JSON line on stderr. A refusal before the run directory is born leaves no run directory. The run directory is BORN with its run.pid
#           (mkdir of a private name, run.pid written, rename(2) onto the run id: rename fails onto a non-empty directory, so of two runs given one id only one
#           proceeds, and no run directory is ever visible without run.pid). Every exit after that moment (a signal, a `set -u` error) writes a minimal report.json
#           (failed_stage host) into the directory it owns, so no later run is blocked by a reportless one; approved_copy_invalid removes its own partial directory.
# Exits     whatever the copied script gives (0, 10 to 15, 20); 20 for every refusal of this script, an approved core that cannot be executed included
#           (approved_copy_invalid core_not_executable: never the shell's own 126), HOME and CPA_HOST_STATE both unset (state_unresolved), and any other status
#           of this script before its exec (a `set -u` error, ANY catchable terminating signal): one JSON line internal_error / host_exit_<status>, never the shell's own.
# Environment  an ALLOWLIST, not a denylist: the interpreter is `#!/bin/bash -p` (imported functions, SHELLOPTS, BASHOPTS, BASH_ENV and ENV are ignored by bash itself, and an absolute
#           interpreter path cannot be replaced through PATH); the first statements install the signal handlers, then any exported name outside the allowlist (HOME PATH TMPDIR CPA_HOST_STATE
#           SKIP_LONG SSH_AUTH_SOCK the commit identity LONGOPS_ALLOW_TMPFS LC_ALL PWD SHLVL and the three CPA_* values of a run) makes the script re-exec itself ONCE through
#           `env -i` with exactly the allowed names (a caller forging the internal marker with a dirty environment is refused 20 env_not_clean); HOME, CPA_HOST_STATE and TMPDIR must be
#           absolute, every PATH element absolute and outside the project root (20 env_value_unsafe). The block is the same text as in commit-push-all.sh; see INSTALL.md "The environment of a run".
# Released copy  after the copy loop the whole released/ tree is made read-only (files 0444/0555, directories 0555); the core re-hashes every helper against the snapshot at each
#           invocation. A same-uid writer can still chmod and race: the achieved independence tier is `instance`, never `capability` (11.4.240(F)).
# Never     writes into the repository's tracked tree, into the state directory or into the store; installs or edits itself; runs a git command
#           that moves a ref; a force, a rebase, a reset.
set -u
# --- cpa signals begin ---
# Every catchable signal that terminates by default ends the process through its EXIT trap with the status 128+n (WF14 N2). This block is the FIRST statement after `set -u`
# (WF17-cpa SIG-1/SIG-2: no interval of the start-up is left without a handler): ONE `kill -l` table read, no fork per number. Each handler FIRST ignores every one of the numbers (a second
# signal can never cut the exit path short, SIG-3), then exits 128+n. The signals that do not terminate (CHLD, CONT, STOP, TSTP, TTIN, TTOU, URG, WINCH) are left alone; KILL and STOP cannot be
# caught and glibc reserves 32 and 33 (bash cannot trap them: status 160/161, no report; the next run closes that run directory).
CPA_SIGS=(); while read -r n nm; do case "$nm" in KILL|STOP|CHLD|CONT|TSTP|TTIN|TTOU|URG|WINCH) continue ;; esac; CPA_SIGS+=("$n"); done \
  < <(n=0; for x in $(kill -l); do case "$x" in *')') n="${x%)}" ;; SIG*) echo "$n ${x#SIG}" ;; esac; done)
for n in "${CPA_SIGS[@]}"; do trap "trap '' ${CPA_SIGS[*]}; exit $((128+n))" "$n" 2>/dev/null; done
cpa_signals_ignore() { trap '' "${CPA_SIGS[@]}" 2>/dev/null; }
# --- cpa signals end ---
# --- cpa env scrub begin ---
# What a run executes and where it pushes is decided by the owner's approvals, never by the caller's environment (WF11 F1/F11, WF14 N1/N3, WF17-cpa ENV). An ALLOWLIST replaces the denylist of
# names: the denylist ran as a script line, after bash had already imported functions, SHELLOPTS and BASHOPTS, and it did not name TMOUT, PYTHONPATH or LD_PRELOAD. PWD and SHLVL are exported by
# bash itself even under `env -i`, so they are listed (bash recomputes them; they carry no caller choice). Any other exported name: the script re-execs itself ONCE through `env -i` with exactly
# the allowed names; the internal first argument marks the re-executed process, and a caller who passes it with a dirty environment is REFUSED, never passed. This text is the same in
# scripts/commit-push-all.sh (matrix section 11).
CPA_ENV_ALLOW=" HOME PATH TMPDIR CPA_HOST_STATE SKIP_LONG SSH_AUTH_SOCK GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL LONGOPS_ALLOW_TMPFS LC_ALL PWD SHLVL CPA_ROOT CPA_RUN_ID CPA_ADOPTION_COMMIT "
_clean=1; _bad=""; for _v in $(compgen -e); do case "$CPA_ENV_ALLOW" in *" $_v "*) ;; *) _clean=0; _bad="$_v" ;; esac; done
if [ "$_clean" = 0 ]; then
  [ "${1:-}" != --cpa-env-cleaned ] || { printf '{"refusal":"env_not_clean","reason":"%s"}\n' "$_bad" >&2; exit 20; }
  _e=(); for _v in $CPA_ENV_ALLOW; do case "$_v" in PWD|SHLVL) continue ;; esac; [ -n "${!_v+x}" ] && _e+=("$_v=${!_v}"); done
  exec /usr/bin/env -i "${_e[@]}" LC_ALL=C /bin/bash -p -- "$0" --cpa-env-cleaned "$@"
fi
[ "${1:-}" != --cpa-env-cleaned ] || shift
export LC_ALL=C
unset _clean _bad _v _e
# --- cpa env scrub end ---
# an exit status outside the documented set (0, 10 to 15, 20: a `set -u` error, a signal) is a refusal 20 of this script, never the shell's own status (WF14 N2/N7); the run directory, once born, gets its report (RES-1)
host_report() { # host_report <reason> <detail>: a minimal report.json in the run directory THIS process owns (its run.pid names $$) and that has none yet
  local rp rs; [ -n "${RUN:-}" ] && [ -d "$RUN" ] && [ ! -e "$RUN/report.json" ] || return 0
  { read -r rp rs < "$RUN/run.pid"; } 2>/dev/null; [ "${rp:-}" = "$$" ] || return 0
  jq -nc --arg id "${rid:-}" --arg dir "$RUN/" --arg r "$1" --arg d "$2" \
    '{schema:1,run_id:$id,run_dir:$dir,exit:20,failed_stage:"host",reason:$r,detail:$d,mode:{},lock:{held:false,released:false},deferred_gates:[],check_pending_release:false,held:false,held_commits:[],nested_unsettled:[],unjudged_paths:[],commits:[],stages:[{id:"S0",name:"host"}],interrupted_runs:[],live_runs:[],files:{}}' \
    > "$RUN/report.json.tmp" 2>/dev/null && mv -f "$RUN/report.json.tmp" "$RUN/report.json" 2>/dev/null \
    || printf '{"schema":1,"run_id":"%s","exit":20,"failed_stage":"host","reason":"%s"}\n' "${rid:-}" "$1" > "$RUN/report.json" 2>/dev/null
}
trap '_rc=$?; case "$_rc" in 0|10|11|12|13|14|15|20) ;; *) host_report internal_error "host_exit_$_rc"; printf "{\"refusal\":\"internal_error\",\"reason\":\"host_exit_%s\"}\n" "$_rc" >&2; exit 20 ;; esac' EXIT
CALLER_DIR="$PWD"
SELF_REL="scripts/repo/host_entry/cpa-host"
CORE_REL="scripts/commit-push-all.sh"

refuse() { # refuse <code word> <reason> [detail]: one JSON line on stderr, exit 20
  jq -nc --arg r "$1" --arg w "$2" --arg d "${3:-}" '{refusal:$r,reason:$w,detail:$d,see:"scripts/repo/host_entry/INSTALL.md"}' >&2 2>/dev/null \
    || printf '{"refusal":"%s","reason":"%s"}\n' "$1" "$2" >&2
  host_report "$1" "$2${3:+: $3}"
  exit 20
}
# the values of the owner's own inputs (WF17-cpa ENV-8/ENV-9): absolute, or the run is refused before any directory is entered. HOME and CPA_HOST_STATE may be EMPTY (state_unresolved below).
for _n in HOME CPA_HOST_STATE TMPDIR; do
  _v="${!_n-}"; [ -z "$_v" ] || case "$_v" in /*) ;; *) refuse env_value_unsafe "$_n" "must be an absolute path" ;; esac
done
case ":$PATH:" in *::*) refuse env_value_unsafe PATH "an empty PATH element means the working directory" ;; esac
_ifs="$IFS"; IFS=:; for _e in $PATH; do case "$_e" in /*) ;; *) IFS="$_ifs"; refuse env_value_unsafe PATH "a relative PATH element" "$_e" ;; esac; done; IFS="$_ifs"; unset _n _v _e _ifs
# no PATH element lies inside a repository the caller stands in (WF17-cpa ENV-9): checked in bash only, textually, BEFORE any external command runs (git would otherwise be the first program a
# work-tree file could replace); the same rule is applied again with realpath once the project root is known
_a="$PWD"
while :; do
  if [ -e "$_a/.git" ]; then
    _ifs="$IFS"; IFS=:; for _e in $PATH; do case "$_e/" in "$_a"/*) IFS="$_ifs"; printf '{"refusal":"env_value_unsafe","reason":"PATH","detail":"an element lies inside the repository %s"}\n' "$_a" >&2; exit 20 ;; esac; done; IFS="$_ifs"
  fi
  [ -n "$_a" ] || break; _a="${_a%/*}"
done; unset _a _e _ifs
# the state directory: CPA_HOST_STATE, else under HOME; neither is a refusal 20 (never the shell's `unbound variable` 1, WF14 N7)
if [ -n "${CPA_HOST_STATE:-}" ]; then STATE="$CPA_HOST_STATE"; elif [ -n "${HOME:-}" ]; then STATE="$HOME/.local/state/cpa-host"; else refuse state_unresolved no_state_dir "neither CPA_HOST_STATE nor HOME is set"; fi
TRUST="$STATE/trust.json"
for t in git jq sha256sum realpath; do command -v "$t" >/dev/null 2>&1 || refuse tool_missing "$t" "INSTALL.md checks jq, sha256sum and realpath before the install"; done

# ---- modes that need no project --------------------------------------------------------------------------------------------------------
case "${1:-}" in
  --owner-trust) refuse owner_op_unimplemented "${2:-}" "approve, retire, revoke and reanchor are the owner checkpoint T046a (CENTRAL C5, C6); not built in this slice" ;;
  --check-provenance|--exec-approved|--resume) refuse mode_unimplemented "$1" "T094d / T121b / CENTRAL C5, C8; not built in this slice" ;;
esac

# ---- (i) the project root --------------------------------------------------------------------------------------------------------------
root=""; cur="$(git rev-parse --show-toplevel 2>/dev/null)" || cur=""
while [ -n "$cur" ]; do
  [ -f "$cur/$SELF_REL" ] && { root="$cur"; break; }
  cur="$(git -C "$cur" rev-parse --show-superproject-working-tree 2>/dev/null)" || cur=""
done
[ -n "$root" ] || refuse project_not_trusted no_project_root "no repository of the chain from the working directory holds $SELF_REL"
cd "$root" || refuse project_not_trusted no_project_root "cannot enter $root"
# no PATH element lies inside the project root: a work-tree file named like a tool would run in place of it (WF17-cpa ENV-9)
_ifs="$IFS"; IFS=:; for _e in $PATH; do _r="$(realpath -m -- "$_e" 2>/dev/null)" || _r="$_e"; case "$_r/" in "$root"/*) IFS="$_ifs"; refuse env_value_unsafe PATH "an element lies inside the project root" "$_e" ;; esac; done; IFS="$_ifs"; unset _e _r _ifs

# ---- (ii) the trust entry ---------------------------------------------------------------------------------------------------------------
key="$(git rev-list --first-parent --max-parents=0 HEAD 2>/dev/null | head -1)"
[ -n "$key" ] || refuse project_not_trusted no_root_commit "HEAD has no root commit"
[ -s "$TRUST" ] || refuse project_not_trusted trust_file_absent "$TRUST (owner install checkpoint T046a)"
jq -e . "$TRUST" >/dev/null 2>&1 || refuse project_not_trusted trust_file_unparsable "$TRUST"
entry="$(jq -c --arg k "$key" '.projects[$k] // empty' "$TRUST" 2>/dev/null)"
[ -n "$entry" ] || refuse project_not_trusted no_entry "no trust entry for the project root $key (owner install checkpoint T046a)"
jq -e --arg p "$CORE_REL" '.manifest|map(.path)|index($p)!=null' <<< "$entry" >/dev/null 2>&1 || refuse project_not_trusted core_not_in_manifest "$CORE_REL is not in the approved manifest"
adopt="$(jq -r '.adoption_commit // empty' <<< "$entry")"
if ! git rev-list --first-parent HEAD 2>/dev/null | grep -qx -- "$adopt"; then refuse project_not_trusted adoption_commit_not_first_parent "$adopt"; fi

if [ "${1:-}" = "--show" ]; then
  printf 'cpa-host sha256 %s\n' "$(sha256sum "$0" | cut -d' ' -f1)"; printf 'project %s\n' "$key"; printf '%s\n' "$entry"; exit 0
fi

# ---- (iii) the run id --------------------------------------------------------------------------------------------------------------------
rid=""; args=(); resume=""
while [ $# -gt 0 ]; do
  case "$1" in
    --run-id) [ $# -ge 2 ] || refuse usage_error run_id_missing "--run-id needs a value"; [ -z "$rid" ] || refuse usage_error run_id_twice "--run-id given twice"; rid="$2"; shift 2 ;;
    --) args+=("$@"); break ;;                       # the options end here: a message equal to --run-id or --paths-from is a message (INPUT-6)
    --resume) [ $# -ge 2 ] || refuse usage_error resume_missing "--resume needs a run id"; resume="$2"; shift 2 ;;
    --paths-from) [ $# -ge 2 ] || { args+=("$1"); shift; continue; }   # a missing value is the copied script's usage_error
      case "$2" in /*) args+=("$1" "$2") ;; *) args+=("$1" "$CALLER_DIR/$2") ;; esac; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
[ -z "$resume" ] || { [ -z "$rid" ] || refuse usage_error run_id_with_resume "--run-id together with --resume"; refuse mode_unimplemented --resume "T121b; not built in this slice"; }
if [ -n "$rid" ]; then
  [[ "$rid" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || refuse run_id_invalid run_id_malformed "$rid"
  [ ! -e ".audit/commit-push/$rid" ] || refuse run_id_invalid run_id_in_use "$rid"
else
  rid="$(date -u +%Y%m%dT%H%M%SZ)-$$-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
fi

# ---- (iv) the run directory and the approved copies --------------------------------------------------------------------------------------
mkdir -p .audit/commit-push 2>/dev/null || refuse run_dir_unwritable ".audit/commit-push"
RUN_FINAL=".audit/commit-push/$rid"
# the run directory is BORN with its run.pid (RES-1 a): a private name, the pid and start ticks written, then rename(2) onto the run id (it fails onto a non-empty directory)
mkdir ".audit/commit-push/.new.$$" 2>/dev/null || refuse run_dir_unwritable "$RUN_FINAL"
printf '%s %s\n' "$$" "$(sed -e 's/^.*) //' "/proc/$$/stat" 2>/dev/null | awk '{print $20}')" > ".audit/commit-push/.new.$$/run.pid" 2>/dev/null || { rm -rf ".audit/commit-push/.new.$$"; refuse run_dir_unwritable "run.pid"; }
mv -T -- ".audit/commit-push/.new.$$" "$RUN_FINAL" 2>/dev/null || { rm -rf ".audit/commit-push/.new.$$"; refuse run_id_invalid run_id_in_use "$rid"; }
RUN="$RUN_FINAL"
mkdir "$RUN/no-hooks" "$RUN/released" || { rm -rf "$RUN"; refuse run_dir_unwritable "$RUN"; }
n="$(jq '.manifest|length' <<< "$entry")"; i=0
while [ "$i" -lt "$n" ]; do
  p="$(jq -r --argjson i "$i" '.manifest[$i].path' <<< "$entry")"; s="$(jq -r --argjson i "$i" '.manifest[$i].sha256' <<< "$entry")"
  x="$(jq -r --argjson i "$i" '.manifest[$i].exec' <<< "$entry")"; i=$((i+1))
  case "$p" in /*|..|../*|*/..|*/../*|-*) rm -rf "$RUN"; refuse approved_copy_invalid unsafe_manifest_path "$p" ;; esac
  blob="$STATE/blobs/$s"
  [ -r "$blob" ] || { rm -rf "$RUN"; refuse approved_copy_invalid store_blob_missing "$p $s"; }
  if ! { mkdir -p "$RUN/released/$(dirname "$p")" && cp -- "$blob" "$RUN/released/$p"; }; then rm -rf "$RUN"; refuse approved_copy_invalid copy_failed "$p"; fi
  chmod u+w "$RUN/released/$p"
  got="$(sha256sum "$RUN/released/$p" | cut -d' ' -f1)"
  [ "$got" = "$s" ] || { rm -rf "$RUN"; refuse approved_copy_invalid hash_mismatch "$p wants $s got $got"; }
  if [ "$x" = true ]; then chmod 755 "$RUN/released/$p"; else chmod 644 "$RUN/released/$p"; fi
done
entries="$(jq -cS '.manifest|sort_by(.path)' <<< "$entry")"
msha="$(printf '%s' "$entries" | sha256sum | cut -d' ' -f1)"
jq -nc --argjson e "$entries" --arg m "$msha" '{schema:"cpa-host-snapshot/1",entries:$e,manifest_sha256:$m}' > "$RUN/released/trust-snapshot.json" \
  || { rm -rf "$RUN"; refuse run_dir_unwritable "snapshot"; }

# ---- (v) execute the copied script --------------------------------------------------------------------------------------------------------
# run.pid was written when the directory was born (the exec keeps the pid): a later run tells a LIVE concurrent run from an interrupted one by it.
# The released copy is made read-only (TOCTOU-6): files 0444 / 0555, directories 0555; the core re-hashes each helper against the snapshot before it runs it.
chmod -R a-w "$RUN/released" 2>/dev/null || { chmod -R u+w "$RUN" 2>/dev/null; rm -rf "$RUN"; refuse approved_copy_invalid chmod_failed "$RUN/released"; }
unset OLDPWD       # bash exports it after the `cd` above; it is no input of the run and the core must find an allowlisted environment (no second re-exec)
export CPA_ROOT="$root" CPA_RUN_ID="$rid" CPA_ADOPTION_COMMIT="$adopt" CPA_HOST_STATE="$STATE"
# an approved core that cannot be executed (the manifest marks it non-executable, or the directory sits on a noexec mount) is a refusal of ours, never the shell's 126
[ -x "$root/$RUN/released/$CORE_REL" ] || { chmod -R u+w "$RUN" 2>/dev/null; rm -rf "$RUN"; refuse approved_copy_invalid core_not_executable "$CORE_REL is not executable in the approved copy"; }
shopt -s execfail
exec "$root/$RUN/released/$CORE_REL" "${args[@]+"${args[@]}"}"
chmod -R u+w "$RUN" 2>/dev/null; rm -rf "$RUN"; refuse approved_copy_invalid exec_failed "$CORE_REL"
