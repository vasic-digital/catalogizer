# Rendered by the nginx image entrypoint (envsubst on /etc/nginx/templates/*.template)
# into /etc/nginx/conf.d/default.conf. Only API_* variables are substituted
# (NGINX_ENVSUBST_FILTER), so nginx's own $host/$uri/... stay intact.
# API_UPSTREAM is the host:port of the catalog-api (default set in the Dockerfile:
# host.containers.internal:8080; in a compose stack use e.g. catalog-api:8080).
# Access log without credentials: a stream ticket or a legacy session token travels in the query string and must never reach the
# log. Redacting named parameters is bypassable (duplicated names, percent-encoded names, new parameter names), so the query
# string is simply never logged: $uri is the path only. (The nginx ERROR log can still print the request line when the upstream is
# unreachable; nginx cannot redact it, see docs/FOLLOW_UPS_NEXT_PHASE.md WL12-F2.)
log_format nocreds '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent "$http_user_agent"';

server {
    access_log /var/log/nginx/access.log nocreds;
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 256;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /ws {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
