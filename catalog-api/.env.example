# Server Configuration
PORT=8080
HOST=localhost
GIN_MODE=debug

# Database
DB_PATH=./data/catalogizer.db

# Security - REQUIRED FOR PRODUCTION
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# Enable authentication (recommended)
ENABLE_AUTH=true

# HTTPS Configuration (for production)
ENABLE_HTTPS=false
CERT_FILE=
KEY_FILE=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Catalog Configuration
TEMP_DIR=./temp
MAX_CONCURRENT_SCANS=3
ENABLE_CACHE=true
CACHE_TTL_MINUTES=15

# Storage Configuration
# Uncomment and modify for your environment
# SMB_SOURCES=smb://server/share
# SMB_USERNAME=username
# SMB_PASSWORD=password

# Development overrides
NODE_ENV=development

# Phase 4.2 — Rate-limit hardening
# TRUSTED_PROXIES values:
#   unset (strict) — ignore X-Forwarded-For; rate-limit by peer IP only
#   auto           — trust loopback + RFC-1918 private ranges (recommended for dev)
#   <cidr>,<cidr>  — explicit allow-list for production proxies
TRUSTED_PROXIES=auto
# Activate Redis-backed distributed rate limiting.
# Redis limiting is used ONLY when BOTH hold: this is "true" AND the Redis
# PING at startup succeeds. Otherwise (unset, or Redis unreachable at
# startup) every process uses its own in-memory per-process limiter, so
# limits are NOT shared across instances. /login and /register always use
# the in-memory limiter. If Redis fails after startup, Redis-limited routes
# answer 503 (fail closed) until Redis is back.
REDIS_RATE_LIMIT=true