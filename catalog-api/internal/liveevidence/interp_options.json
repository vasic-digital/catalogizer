    },
    {
     "opt": "-XX:+UseSerialGC",
     "val": "none"
    },
    {
     "opt": "-XX:+UseParallelGC",
     "val": "none"
    },
    {
     "opt": "-jar",
     "val": "next",
     "script": true,
     "ex": "app.jar"
    },
    {
     "opt": "-Xmx",
     "val": "attached",
     "re": "^[0-9]+[kKmMgG]?$",
     "ex": "512m"
    },
    {
     "opt": "-Xms",
     "val": "attached",
     "re": "^[0-9]+[kKmMgG]?$",
     "ex": "128m"
    },
    {
     "opt": "-Xss",
     "val": "attached",
     "re": "^[0-9]+[kKmMgG]?$",
     "ex": "1m"
    },
    {
     "opt": "-D",
     "val": "attached",
     "re": "^(server\\.port|file\\.encoding|user\\.timezone|user\\.language|user\\.country|java\\.awt\\.headless|java\\.net\\.preferIPv4Stack)=[A-Za-z0-9._:-]*$",
     "ex": "server.port=8080"
    }
   ],
   "dangerous": [
    "-cp",
    "-classpath",
    "--class-path",
    "-p",
    "--module-path",
    "--patch-module",
    "--add-modules",
    "--upgrade-module-path",
    "--limit-modules",
    "prefix:-javaagent",
    "prefix:-agentlib",
    "prefix:-agentpath",
    "prefix:-Xbootclasspath",
    "prefix:-Xrun",
    "prefix:-XX:Flags",
    "prefix:-XX:OnError",
    "prefix:-XX:+UnlockDiagnostic",
    "prefix:-Djava.class.path",
    "prefix:-Djava.system.class.loader",
    "prefix:-Djava.ext.dirs",
    "prefix:-Xshare:dump"
   ],
   "positional_script": false
  },
  "ruby": {
   "exe": "^ruby",
   "benign": [
    {
     "opt": "-w",
     "val": "none"
    },
    {
     "opt": "-W0",
     "val": "none"
    },
    {
     "opt": "-W1",
     "val": "none"
    },
    {
     "opt": "-W2",
     "val": "none"
    },
    {
     "opt": "-v",
     "val": "none"
    }
   ],
   "dangerous": [
    "-S",
    "prefix:-e",
    "prefix:-r",
    "prefix:-I",
    "prefix:-x",
    "prefix:-C",
    "--require",
    "--enable",
    "--disable",
    "--encoding"
   ]
  },
  "perl": {
   "exe": "^perl",
   "benign": [
    {
     "opt": "-w",
     "val": "none"
    },
    {
     "opt": "-W",
     "val": "none"
    },
    {
     "opt": "-t",
     "val": "none"
