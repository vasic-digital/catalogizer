# Security Scanning Environment Variables
# Copy to .env.security (gitignored) and fill in real values. Never commit secrets.

# SonarQube Configuration
SONARQUBE_URL=CHANGE_ME
SONARQUBE_USERNAME=CHANGE_ME
SONARQUBE_PASSWORD=CHANGE_ME

# Snyk Configuration (Get token from https://app.snyk.io/account)
SNYK_TOKEN=CHANGE_ME
SNYK_ORG=CHANGE_ME
SNYK_SEVERITY_THRESHOLD=CHANGE_ME

# SonarQube Project Token (Generate in SonarQube UI after setup)
SONAR_TOKEN=CHANGE_ME
